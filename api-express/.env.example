# Copier ce fichier en .env puis remplacer les valeurs (le fichier .env n'est jamais commité).

# Chaîne de connexion MongoDB Atlas : Atlas > Database > Connect > Drivers.
# Remplacer <utilisateur> et <mot_de_passe> (encoder les caractères spéciaux : @ devient %40, # devient %23…).
# Le nom de la base (cabinet_medical) se place juste avant le « ? ».
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@cluster0.xxxxx.mongodb.net/cabinet_medical?retryWrites=true&w=majority&appName=Cluster0

# Port du serveur Express (Postman appelle http://localhost:3000/api).
PORT=3000

# Clé qui signe les jetons de connexion (JWT) : une longue phrase secrète, propre à chaque serveur.
# Facultative en développement (une clé de développement est alors utilisée), obligatoire en production.
# JWT_SECRET=remplacer-par-une-longue-phrase-secrete
# Durée de validité d'un jeton (2h par défaut) : 30m, 2h, 1d…
# JWT_DUREE=2h

# Seulement en cas d'erreur « querySrv ECONNREFUSED » ou « ENOTFOUND _mongodb._tcp » (DNS du réseau) :
# DNS_SERVEURS=8.8.8.8,1.1.1.1

# Base utilisée uniquement par « npm test » : elle est vidée à chaque test, ne jamais y mettre la base de démo.
# MONGODB_URI_TEST=mongodb://localhost:27017/cabinet_medical_test
