{
  "name": "cabinet-medical-api",
  "version": "1.0.0",
  "description": "API REST du cabinet médical (Express + MongoDB Atlas) : CRUD des classes du diagramme de classes",
  "main": "server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
